{% doc %}
  @prompt
    Create a low stock warning badge for the product page that shows "Only X left in stock!" message when inventory is 5 or fewer items remaining. The badge should be visually prominent, styled to match a premium natural wellness brand, and automatically show the actual stock number. It should disappear when stock is above 5.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% assign inventory_quantity = product.selected_or_first_available_variant.inventory_quantity %}
{% assign inventory_policy = product.selected_or_first_available_variant.inventory_policy %}
{% assign inventory_management = product.selected_or_first_available_variant.inventory_management %}

{% assign show_badge = false %}
{% if inventory_management != blank and inventory_policy == 'deny' %}
  {% if inventory_quantity <= block.settings.stock_threshold and inventory_quantity > 0 %}
    {% assign show_badge = true %}
  {% endif %}
{% endif %}

{% if show_badge %}
  {% style %}
    .ai-low-stock-badge-{{ ai_gen_id }} {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
      background-color: {{ block.settings.background_color }};
      color: {{ block.settings.text_color }};
      border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
      border-radius: {{ block.settings.border_radius }}px;
      font-size: {{ block.settings.font_size }}px;
      font-weight: {{ block.settings.font_weight }};
      width: {{ block.settings.desktop_width_percent }}%;
      max-width: 100%;
      justify-content: center;
    }

    .ai-low-stock-badge__icon-{{ ai_gen_id }} {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .ai-low-stock-badge__icon-{{ ai_gen_id }} svg {
      width: {{ block.settings.icon_size }}px;
      height: {{ block.settings.icon_size }}px;
      fill: {{ block.settings.icon_color }};
    }

    .ai-low-stock-badge__text-{{ ai_gen_id }} {
      line-height: 1.2;
    }

    @media screen and (max-width: 749px) {
      .ai-low-stock-badge-{{ ai_gen_id }} {
        font-size: calc({{ block.settings.font_size }}px * 0.9);
      }

      .ai-low-stock-badge__icon-{{ ai_gen_id }} svg {
        width: calc({{ block.settings.icon_size }}px * 0.9);
        height: calc({{ block.settings.icon_size }}px * 0.9);
      }
    }
  {% endstyle %}

  <div class="ai-low-stock-badge-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    {% if block.settings.show_icon %}
      <span class="ai-low-stock-badge__icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5zm0 18c-3.86-.93-7-5.43-7-10V8.3l7-3.11v14.81zm7-10c0 4.57-3.14 9.07-7 10V5.19l7 3.11V10z"/>
        </svg>
      </span>
    {% endif %}
    <span class="ai-low-stock-badge__text-{{ ai_gen_id }}">
      {% if block.settings.custom_text != blank %}
        {{ block.settings.custom_text | replace: '[stock]', inventory_quantity }}
      {% else %}
        Only {{ inventory_quantity }} left in stock!
      {% endif %}
    </span>
  </div>
{% endif %}

{% schema %}
{
  "name": "Low stock badge",
  "settings": [
    {
      "type": "header",
      "content": "Stock settings"
    },
    {
      "type": "range",
      "id": "stock_threshold",
      "label": "Show badge when stock is",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 5,
      "info": "Badge appears when inventory is at or below this number"
    },
    {
      "type": "text",
      "id": "custom_text",
      "label": "Custom message",
      "default": "Only [stock] left in stock!",
      "info": "Use [stock] to show the actual number"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFF4E6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#D4A574"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": true
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#D4A574"
    }
  ],
  "presets": [
    {
      "name": "Low stock badge"
    }
  ]
}
{% endschema %}