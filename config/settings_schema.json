[
  {
    "name": "theme_info",
    "theme_name": "AskNatural React",
    "theme_version": "1.1.0",
    "theme_author": "AskNatural",
    "theme_documentation_url": "https://shopify.dev/docs/storefronts/themes",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Storefront API",
    "settings": [
      {
        "type": "paragraph",
        "content": "Create a custom app with Storefront API access. Paste the public token below (Theme settings — never commit real tokens)."
      },
      {
        "type": "text",
        "id": "storefront_access_token",
        "label": "Storefront API access token"
      }
    ]
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo (light — for dark header)"
      },
      {
        "type": "image_picker",
        "id": "logo_dark",
        "label": "Logo (dark — for light backgrounds)"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "paragraph",
        "content": "Defaults match AskNatural design mockups. Components use these via CSS variables."
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary green",
        "default": "#2D4F1E"
      },
      {
        "type": "color",
        "id": "color_primary_dark",
        "label": "Primary dark",
        "default": "#1E3614"
      },
      {
        "type": "color",
        "id": "color_cream",
        "label": "Cream background",
        "default": "#F5F1EB"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Body text",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Page background",
        "default": "#FFFFFF"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "libre_baskerville_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "dm_sans_n4"
      }
    ]
  },
  {
    "name": "Gokwik",
    "settings": [
      {
        "type": "text",
        "id": "mid",
        "label": "Merchant Id"
      },
      {
        "type": "header",
        "content": "Select environment"
      },
      {
        "type": "select",
        "id": "envType",
        "default": "production",
        "options": [
          {
            "value": "qa",
            "label": "QA"
          },
          {
            "value": "sandbox",
            "label": "Sandbox"
          },
          {
            "value": "production",
            "label": "Production"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "hideFlow",
        "label": "Button hide without disable",
        "info": "To hide only button without disable Gokwik flow",
        "default": false
      },
      {
        "type": "header",
        "content": "Data Tracking"
      },
      {
        "type": "text",
        "id": "ga4Gokwik",
        "label": "Enter Google Analytics ID (GA4)",
        "placeholder": "Starts with GA- ...."
      },
      {
        "type": "text",
        "id": "fbpixel",
        "label": "FB Pixel"
      },
      {
        "type": "text",
        "id": "snapPixel",
        "label": "Snapchat Pixel"
      },
      {
        "type": "text",
        "id": "gadsGokwik",
        "label": "Google Ads Conversion ID (AW-…)"
      },
      {
        "type": "header",
        "content": "Checkout Button"
      },
      {
        "type": "checkbox",
        "id": "goEnable",
        "label": "Enable Checkout Interception",
        "info": "GoKwik will intercept native checkout buttons automatically",
        "default": true
      },
      {
        "type": "text",
        "id": "checkoutSubText",
        "label": "Checkout Button Sub Text",
        "placeholder": "e.g. ₹100 Off on prepaid orders",
        "info": "Leave blank to hide sub text on checkout button"
      },
      {
        "type": "checkbox",
        "id": "checkoutEnableLogo",
        "label": "Show Payment Icons on Checkout Button",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "checkoutEnableBanner",
        "label": "Show Checkout Sub Text as Banner (above button)",
        "default": false
      },
      {
        "type": "header",
        "content": "Buy Now Button"
      },
      {
        "type": "checkbox",
        "id": "goBuynowEnable",
        "label": "Enable Buy Now Interception",
        "info": "GoKwik will intercept native buy now buttons automatically",
        "default": true
      },
      {
        "type": "text",
        "id": "buyNowText",
        "label": "Buy Now Button Text",
        "default": "Buy It Now"
      },
      {
        "type": "text",
        "id": "buyNowSubText",
        "label": "Buy Now Button Sub Text",
        "placeholder": "e.g. ₹100 Off on prepaid orders",
        "info": "Leave blank to hide sub text on buy now button"
      },
      {
        "type": "checkbox",
        "id": "buyNowEnableLogo",
        "label": "Show Payment Icons on Buy Now Button",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "buyNowEnableBanner",
        "label": "Show Buy Now Sub Text as Banner (above button)",
        "default": false
      },
      {
        "type": "header",
        "content": "Other Settings"
      },
      {
        "type": "checkbox",
        "id": "enableIntlFlow",
        "label": "Enable International Flow"
      }
    ]
  }
]